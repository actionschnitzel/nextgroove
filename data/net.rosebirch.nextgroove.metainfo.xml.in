<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.rosebirch.nextgroove</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>NextGroove</name>
  <summary>Linux client for Nextcloud Music</summary>
  <description>
    <p>Linux client for Nextcloud Music.</p>
    <p>Features: </p>
    <ul>
      <li>Connects to a Nextcloud instance of your choice via normal API tokens (does not use subsonic/ampache endpoints but the <a href="https://github.com/owncloud/music?tab=readme-ov-file#api">Nextcloud ones</a></li>
      <li>Can select music from an album view (most recent first), a full list of songs in the collection, or playlists.</li>
      <li>Can append to the queue from album and collections view, but not from playlist view.</li>
      <li>Basic MPRIS support allowing to be controlled via common controls and shortcuts.</li>
    </ul>
  </description>

  <developer id="net.rosebirch">
    <name>Dean Birch</name>
  </developer>

  <!-- Requered: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://gitlab.gnome.org/dean36963/NextGroove</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://gitlab.gnome.org/dean36963/NextGroove</url>

  <translation type="gettext">nextgroove</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">net.rosebirch.nextgroove.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <screenshots>
    <screenshot type="source">
      <image>https://gitlab.gnome.org/dean36963/NextGroove/-/raw/main/screenshots/screenshot1.png</image>
      <caption>Screenshot of the album view of NextGroove</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2024-01-22">
      <!--url type="details">https://example.org/changelog.html#version_1.0.1</url-->
      <description translate="no">
        <p>Initial release</p>
      </description>
    </release>
  </releases>

</component>

