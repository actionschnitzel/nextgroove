<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2025 Dean Birch -->
<component type="desktop-application">
  <id>net.rosebirch.nextgroove</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>NextGroove</name>
  <summary>Play music from Nextcloud</summary>
  <description>
    <p>Nextgroove lets you browse and play songs from your Nextcloud instance (with Nextcloud Music installed).</p>
    <p>Features: </p>
    <ul>
      <li>Connects to a Nextcloud instance of your choice via normal API tokens (does not use subsonic/ampache endpoints but the Nextcloud ones).</li>
      <li>Does download album art, images in screenshots are modified for copyright reasons.</li>
      <li>Can select music from an album view (most recent first), a full list of songs in the collection, or playlists.</li>
      <li>Can select albums, playlists or individual songs from either to the queue.</li>
      <li>Basic MPRIS support allowing to be controlled via common controls and shortcuts.</li>
      <li>Can create playlists from the current play queue.</li>
    </ul>
  </description>

  <developer id="net.rosebirch">
    <name>Dean Birch</name>
  </developer>

  <!-- Requered: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://gitlab.gnome.org/dean36963/NextGroove</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://gitlab.gnome.org/dean36963/NextGroove</url>

  <translation type="gettext">nextgroove</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">net.rosebirch.nextgroove.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <icon type="stock">net.rosebirch.nextgroove</icon>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
  </categories>

  <keywords>
    <keyword>Nextcloud</keyword>
  </keywords>

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#9988f0</color>
    <color type="primary" scheme_preference="dark">#646464</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://gitlab.gnome.org/dean36963/nextgroove/-/raw/0.2.0-rc2/screenshots/screenshot1.png</image>
      <caption>Screenshot of the album view of NextGroove</caption>
    </screenshot>
    <screenshot>
      <image>https://gitlab.gnome.org/dean36963/nextgroove/-/raw/0.2.0-rc2/screenshots/screenshot2.png</image>
      <caption>Album details view of NextGroove</caption>
    </screenshot>
    <screenshot>
      <image>https://gitlab.gnome.org/dean36963/nextgroove/-/raw/0.2.0-rc2/screenshots/screenshot3.png</image>
      <caption>Viewing a playlist in NextGroove</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.0" date="2025-05-05">
      <description translate="no">
        <p>Save your current play queue as a playlist. Queue items can be reordered.</p>
        <p>Album covers should be requested less frequently and are cached.</p>
        <p>Clicking an album in album view goes straight to details.</p>
        <p>Covers now displayed in playlist and queue view alongside each song and in the now playing area.</p>
        <p>Covers now displayed via MPRIS in the now playing area.</p>
        <p>Time formats now displayed in MM:SS format (or H:MM:SS if long enough), rather than truncated to just the seconds if short enough.</p>
        <p>Duration can be viewed more visually with a level bar widget. Seeking not yet supported.</p>
        <p>Moving to GNOME SDK 48.</p>
      </description>
    </release>
    <release version="0.1.6" date="2025-04-12">
      <description translate="no">
        <p>Updating to work with newer versions of the Nextcloud Music API. This is not backwards compatible though.</p>
        <p>Added a text view showing duration.</p>
      </description>
    </release>
    <release version="0.1.5" date="2025-03-23">
      <description translate="no">
        <p>Updating icons</p>
      </description>
    </release>
    <release version="0.1.4" date="2025-03-22">
      <description translate="no">
        <p>Initial flatpak release</p>
        <p>Songs displayed in any view show in bold if they are now playing.</p>
        <p>Should be usable on smaller screens.</p>
        <p>Queue and playlist view have a bit of a visual revamp.</p>
      </description>
    </release>
    <release version="0.1.1" date="2025-03-13">
      <!--url type="details">https://example.org/changelog.html#version_1.0.1</url-->
      <description translate="no">
        <p>Reworking collection view</p>
        <p>Collection view is now under the Artists tab. Instead of a table format
          this is now in a structured format under artists/albums, leading to a
          more detailed album view.
        </p>
        <p>The same album details view can be accessed from the albums tab.</p>
        <p>Also should work slightly better on a mobile format.</p>
      </description>
    </release>
    <release version="0.1.0" date="2025-01-22">
      <!--url type="details">https://example.org/changelog.html#version_1.0.1</url-->
      <description translate="no">
        <p>Initial release</p>
      </description>
    </release>
  </releases>

</component>

