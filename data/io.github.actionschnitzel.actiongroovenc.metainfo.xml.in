<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2025 Dean Birch -->
<component type="desktop-application">
  <id>io.github.actionschnitzel.actiongroovenc</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>ActionGrooveNC</name>
  <summary>Play music from Nextcloud</summary>
  <description>
    <p>ActionGrooveNC lets you browse and play songs from your Nextcloud instance (with Nextcloud Music installed).</p>
    <p>Features: </p>
    <ul>
      <li>Connects to a Nextcloud instance of your choice.</li>
      <li>Does download album art, images in screenshots are modified for copyright reasons.</li>
      <li>Can select albums, playlists or individual songs from either to the queue.</li>
      <li>Basic MPRIS support allowing to be controlled via common controls and shortcuts.</li>
      <li>Can create playlists from the current play queue.</li>
      <li>Able to optionally cache songs</li>
    </ul>
  </description>

  <developer id="io.github.actionschnitzel">
    <name>Dean Birch</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://gitlab.gnome.org/dean36963/NextGroove</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://gitlab.gnome.org/dean36963/NextGroove</url>

  <translation type="gettext">actiongroovenc</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">io.github.actionschnitzel.actiongroovenc.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <icon type="stock">io.github.actionschnitzel.actiongroovenc</icon>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
  </categories>

  <keywords>
    <keyword>Nextcloud</keyword>
    <keyword>Music</keyword>
  </keywords>

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#9988f0</color>
    <color type="primary" scheme_preference="dark">#646464</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://gitlab.gnome.org/dean36963/nextgroove/-/raw/0.2.0-rc2/screenshots/screenshot1.png</image>
      <caption>Screenshot of the album view of ActionGrooveNC</caption>
    </screenshot>
    <screenshot>
      <image>https://gitlab.gnome.org/dean36963/nextgroove/-/raw/0.2.0-rc2/screenshots/screenshot2.png</image>
      <caption>Album details view of ActionGrooveNC</caption>
    </screenshot>
    <screenshot>
      <image>https://gitlab.gnome.org/dean36963/nextgroove/-/raw/0.2.0-rc2/screenshots/screenshot3.png</image>
      <caption>Viewing a playlist in ActionGrooveNC</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.6" date="2026-11-11">
      <description translate="no">
        <p>Rebrand to ActionGrooveNC, albums sorted alphabetically, queue as resizable pane, search bar, German translation.</p>
        <p>Fixes for playback crash with ID3-tagged MP3 files and for startup outside Flatpak.</p>
      </description>
    </release>
    <release version="0.5.1" date="2026-09-17">
      <description translate="no">
        <p>Hotfix for changes in Nextcloud to authenticate properly.</p>
        <p>Main functionality working ok but scrobbling and playlist creation/deletion is impacted.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-06-15">
      <description translate="no">
        <p>Able to add songs to queue in a shuffled format</p>
        <p>Changed UI around queue reordering to also allow song removal, only shown for highlighted song.</p>
        <p>Improving some layouts</p>
      </description>
    </release>
    <release version="0.4.1" date="2026-01-12">
      <description translate="no">
        <p>Fix login issue</p>
      </description>
    </release>
    <release version="0.4.0" date="2025-12-14">
      <description translate="no">
        <p>NextGroove wrapped! View your top played songs/albums/artists from lifetime playcount, or comparing to a previous snapshot. Saves a snapshot to be compared against later.</p>
        <p>Improved security of token storage.</p>
      </description>
    </release>
    <release version="0.3.1" date="2025-12-06">
      <description translate="no">
        <p>Play count recorded in Nextcloud is incremented at halfway through a song.</p>
      </description>
    </release>
    <release version="0.3.0" date="2025-11-18">
      <description translate="no">
        <p>Easier to login to an instance now. Instead of manually creating app passwords, just set the server name and it opens a browser window to authenticate.</p>
        <p>Move to Gnome SDK 49.</p>
      </description>
    </release>
    <release version="0.2.4" date="2025-07-17">
      <description translate="no">
        <p>Adding ability to cache songs locally. There is no limit to this, but you can clear manually in settings.</p>
        <p>Aligning text was misaligned and now is realigned.</p>
        <p>MPRIS now changes to not playing once the queue ends.</p>
        <p>Queue page was previously unscrollable on touch devices as the entire row was a drag source. Now you can only drag from a designated marker.</p>
        <p>Song titles now are ellipsized (…) to avoid horizontal scrolling. This should be more noticeable on a mobile device.</p>
        <p>The now playing area is now more readable on a mobile and should display above the normal controls rather than bottom left for mobiles.</p>
      </description>
    </release>
    <release version="0.2.3" date="2025-07-07">
      <description translate="no">
        <p>Queue shows a badge number indicating size of the queue, so even if the playback isn't instantaneous, there's some feedback.</p>
        <p>Also shows a spinner during downloading, again adding feedback for slow network situations.</p>
        <p>Any stdout is also logged now to a file, this cycles on each run.</p>
        <p>If there is a network error during song download, a "network disconnect" icon is displayed on the controls, though clicking it doesn't retry yet.</p>
      </description>
    </release>
    <release version="0.2.2" date="2025-07-01">
      <description translate="no">
        <p>Prevent automatic suspending during music playback.</p>
      </description>
    </release>
    <release version="0.2.1" date="2025-05-24">
      <description translate="no">
        <p>Fix issue where switcher bar wasn't displayed, mostly on mobile devices on startup.</p>
      </description>
    </release>
    <release version="0.2.0" date="2025-05-05">
      <description translate="no">
        <p>Save your current play queue as a playlist. Queue items can be reordered.</p>
        <p>Album covers should be requested less frequently and are cached.</p>
        <p>Clicking an album in album view goes straight to details.</p>
        <p>Covers now displayed in playlist and queue view alongside each song and in the now playing area.</p>
        <p>Covers now displayed via MPRIS in the now playing area.</p>
        <p>Time formats now displayed in MM:SS format (or H:MM:SS if long enough), rather than truncated to just the seconds if short enough.</p>
        <p>Duration can be viewed more visually with a level bar widget. Seeking not yet supported.</p>
        <p>Moving to GNOME SDK 48.</p>
      </description>
    </release>
    <release version="0.1.6" date="2025-04-12">
      <description translate="no">
        <p>Updating to work with newer versions of the Nextcloud Music API. This is not backwards compatible though.</p>
        <p>Added a text view showing duration.</p>
      </description>
    </release>
    <release version="0.1.5" date="2025-03-23">
      <description translate="no">
        <p>Updating icons</p>
      </description>
    </release>
    <release version="0.1.4" date="2025-03-22">
      <description translate="no">
        <p>Initial flatpak release</p>
        <p>Songs displayed in any view show in bold if they are now playing.</p>
        <p>Should be usable on smaller screens.</p>
        <p>Queue and playlist view have a bit of a visual revamp.</p>
      </description>
    </release>
    <release version="0.1.1" date="2025-03-13">
      <!--url type="details">https://example.org/changelog.html#version_1.0.1</url-->
      <description translate="no">
        <p>Reworking collection view</p>
        <p>Collection view is now under the Artists tab. Instead of a table format
          this is now in a structured format under artists/albums, leading to a
          more detailed album view.
        </p>
        <p>The same album details view can be accessed from the albums tab.</p>
        <p>Also should work slightly better on a mobile format.</p>
      </description>
    </release>
    <release version="0.1.0" date="2025-01-22">
      <!--url type="details">https://example.org/changelog.html#version_1.0.1</url-->
      <description translate="no">
        <p>Initial release</p>
      </description>
    </release>
  </releases>

</component>

