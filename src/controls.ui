<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="Controls" parent="GtkActionBar">
    <child>
      <object class="GtkBox" id="leftside">
      </object>
    </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="nowplaying">
                <property name="label"></property>
                <property name="halign">start</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="current_album_artist">
                <property name="label"></property>
                <property name="halign">start</property>
                <property name="hexpand">True</property>
              </object>
            </child>
          </object>
        </child>
        <child type="center">
          <object class="GtkBox">
            <property name="halign">center</property>
            <child>
              <object class="GtkButton" id="previous">
                <property name="label">prev</property>
                <property name="icon-name">media-skip-backward-symbolic</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="playpause">
                <property name="label">play/pause</property>
                <property name="icon-name">media-playback-start-symbolic</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="next">
                <property name="label">next</property>
                <property name="icon-name">media-skip-forward-symbolic</property>
              </object>
            </child>
          </object>
        </child>
    <child>
      <object class="GtkBox" id="right">
        <property name="hexpand">True</property>
      </object>
    </child>
  </template>
</interface>
