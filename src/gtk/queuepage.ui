<?xml version="1.0" encoding="UTF-8"?>
  <interface>
    <requires lib="gtk" version="4.0"/>
    <template class="QueuePage" parent="GtkBox">
      <property name="has_tooltip">True</property>
      <property name="valign">start</property>
      <property name="orientation">vertical</property>
      <child>
        <object class="GtkBox">
          <property name="valign">end</property>
          <property name="orientation">horizontal</property>
          <child>
            <object class="GtkEntry" id="_queue_name_entry">
              <property name="visible">False</property>
              <property name="placeholder-text">Name of Playlist</property>
            </object>
          </child>
          <child>
            <object class="GtkButton" id="_save_queue_as_playlist_button">
              <property name="icon-name">document-save</property>
              <property name="tooltip-text">Save current queue as playlist</property>
            </object>
          </child>
        </object>
      </child>
      <child>
        <object class="GtkListView" id="queueview">
        </object>
      </child>
    </template>
    <!--<menu id="queue_song_click_menu">
      <section>
        <item>
          <attribute name="label" translatable="yes">_Play</attribute>
          <attribute name="action">app.queue_song_play_clicked</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Remove_from_queue</attribute>
          <attribute name="action">app.song_queue_add_end_clicked</attribute>
        </item>
      </section>
    </menu>-->
  </interface>
