<?xml version="1.0" encoding="UTF-8"?>
  <interface>
    <requires lib="gtk" version="4.0"/>
    <template class="QueuePage" parent="GtkOverlay">
      <child type="overlay">
        <object class="GtkBox">
          <property name="halign">end</property>
          <property name="valign">end</property>
          <property name="orientation">horizontal</property>
          <property name="spacing">8</property>
          <property name="margin-end">10</property>
          <property name="margin-bottom">10</property>
          <child>
            <object class="GtkButton" id="_save_queue_as_playlist_button">
              <property name="icon-name">document-save</property>
              <property name="tooltip-text">Save current queue as playlist</property>
              <style>
                <class name="osd"/>
                <class name="circular"/>
              </style>
            </object>
          </child>
          <child>
            <object class="GtkButton" id="_clear_queue_button">
              <property name="icon-name">edit-clear-all-symbolic</property>
              <property name="tooltip-text">Clear queue</property>
              <style>
                <class name="osd"/>
                <class name="circular"/>
              </style>
            </object>
          </child>
          <child>
            <object class="GtkEntry" id="_queue_name_entry">
              <property name="visible">False</property>
              <property name="placeholder-text">Name of Playlist</property>
              <style>
                <class name="osd"/>
              </style>
            </object>
          </child>
          <child>
            <object class="GtkButton" id="_hide_playlist_save">
              <property name="icon-name">window-close-symbolic</property>
              <property name="visible">False</property>
              <property name="tooltip-text">Cancel save as playlist</property>
              <style>
                <class name="osd"/>
                <class name="circular"/>
              </style>
            </object>
          </child>
        </object>
      </child>
      <child type="overlay">
        <object class="GtkBox" id="_queue_placeholder">
          <property name="halign">center</property>
          <property name="valign">center</property>
          <property name="margin-start">24</property>
          <property name="margin-end">24</property>
          <style>
            <class name="queue-placeholder"/>
          </style>
          <child>
            <object class="GtkLabel">
              <property name="label">Drop songs here</property>
              <style>
                <class name="dim-label"/>
              </style>
            </object>
          </child>
        </object>
      </child>
      <child>
        <object class="GtkScrolledWindow">
          <child>
            <object class="GtkBox">
              <property name="has_tooltip">True</property>
              <property name="valign">fill</property>
              <property name="vexpand">True</property>
              <property name="orientation">vertical</property>
              <child>
                <object class="GtkListView" id="queueview">
                  <property name="vexpand">True</property>
                  <style>
                    <class name="queue-list"/>
                  </style>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
    </template>
  </interface>
