<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="Controls" parent="GtkActionBar">
    <child type="start">
      <object class="GtkScrolledWindow">
        <property name="hexpand">true</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="halign">start</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkImage" id="cover">
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="hexpand">false</property>
                <property name="vexpand">false</property>
                <property name="height-request">40</property>
                <property name="width-request">40</property>
                <property name="visible">true</property>
                <property name="margin-end">10</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="nowplaying">
                    <property name="halign">start</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="current_album_artist">
                    <property name="halign">start</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <child>
                      <object class="GtkLabel" id="duration_label">
                        <property name="halign">start</property>
                        <property name="label"></property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLevelBar" id="duration_scale">
                        <property name="visible">false</property>
                        <property name="margin-start">5</property>
                        <property name="margin-end">5</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="max_duration_label">
                        <property name="halign">start</property>
                        <property name="label"></property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>


      </object>
    </child>
    <child type="center">
      <object class="GtkBox">
        <property name="halign">center</property>
        <child>
          <object class="GtkButton" id="previous">
            <property name="label">prev</property>
            <property name="icon-name">media-skip-backward-symbolic</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="playpause">
            <property name="label">play/pause</property>
            <property name="icon-name">media-playback-start-symbolic</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="next">
            <property name="label">next</property>
            <property name="icon-name">media-skip-forward-symbolic</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkBox">
        <property name="halign">end</property>
        <child>
          <object class="AdwSpinner" id="loading">
            <property name="visible">false</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="volumebutton">
            <property name="label">vol</property>
            <property name="icon-name">audio-volume-high-symbolic</property>
          </object>
        </child>
        <child>
          <object class="GtkPopover" id="volumepopover">
            <property name="position">left</property>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkScale" id="volumescale">
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
