<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="NextcloudmusicSettingsWindow" parent="AdwPreferencesDialog">
    <property name="title" translatable="true">Preferences</property>
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="true">Server Settings</property>
            <child>
              <object class="AdwEntryRow" id="_server_row">
                <property name="title" translatable="true">Server URL</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="_user_row">
                <property name="title" translatable="true">User</property>
              </object>
            </child>
            <child>
              <object class="AdwPasswordEntryRow" id="_token_row">
                <property name="title" translatable="true">Token</property>
              </object>
            </child>
          </object>
      </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="true">Cache Settings</property>
            <child>
              <object class="AdwSwitchRow" id="_cache_row">
                <property name="title" translatable="true">Use Cache</property>
              </object>
            </child>
            <child>
              <object class="AdwButtonRow" id="_clear_cache_row">
                <property name="title" translatable="true">Clear Cache</property>
                  <style>
                    <class name="destructive-action"/>
                  </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
