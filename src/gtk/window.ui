<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NextcloudmusicWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">NextGroove</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <child>
      <object class="AdwBreakpoint">
         <condition>max-width: 600sp</condition>
        <setter object="switcher_bar" property="reveal">True</setter>
          <setter object="header_bar" property="title-widget"/>
        </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 680sp</condition>
        <setter object="outer_artist_split" property="collapsed">True</setter>
        <setter object="inner_artist_split" property="sidebar-width-fraction">0.33</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 500sp</condition>
        <setter object="outer_artist_split" property="collapsed">True</setter>
        <setter object="inner_artist_split" property="sidebar-width-fraction">0.33</setter>
        <setter object="inner_artist_split" property="collapsed">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="title-widget">
              <object class="AdwViewSwitcher">
                <property name="stack">stack</property>
                <property name="policy">wide</property>
              </object>
            </property>
            <child type="end">
-              <object class="GtkMenuButton">
-                <property name="primary">True</property>
-                <property name="icon-name">open-menu-symbolic</property>
-                <property name="tooltip-text" translatable="yes">Main Menu</property>
-                <property name="menu-model">primary_menu</property>
-              </object>
-            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwViewStack" id="stack">
            <child>
              <object class="AdwViewStackPage" id="welcomepage">
                <property name="name">welcome</property>
                <property name="title">Welcome</property>
                <property name="icon-name">user-home-symbolic</property>
                <property name="child">
 <object class="AdwStatusPage" >
                    <property name="title">Welcome</property>
                    <property name="description">Checking connection. If you have not yet set connection details, check settings.</property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="AdwViewStackPage" id="album_stack">
                <property name="name">albums</property>
                <property name="title">Albums</property>
                <property name="icon-name">media-optical-cd-audio-symbolic</property>
                <property name="visible">False</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="_scrolled_window">
                    <child>
                      <object class="GtkGridView" id="albumview">
                        <property name="max-columns">10</property>
                        <property name="single-click-activate">True</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>

              <object class="AdwViewStackPage" id="artist_stack">
                <property name="name">artist</property>
                <property name="title">Artist</property>
                <property name="visible">False</property>
                <property name="icon-name">system-users</property>
                <property name="child">
                  <object class="AdwNavigationSplitView" id="outer_artist_split">
                    <property name="min-sidebar-width">200</property>
                    <property name="max-sidebar-width">500</property>
                    <property name="sidebar-width-fraction">0.37</property>
                    <property name="sidebar">
                      <object class="AdwNavigationPage" id="artist_nav_1">
                        <property name="title" translatable="yes">Artists</property>
                        <property name="tag">artist_list</property>
                        <property name="child">
                            <object class="AdwNavigationSplitView" id="inner_artist_split" >
                              <property name="max-sidebar-width">200</property>
                              <property name="sidebar-width-fraction">0.38</property>
                              <property name="sidebar">
                                <object class="AdwNavigationPage" id="artist_nav_2">
                                  <property name="title" translatable="yes">Content</property>
                                  <property name="tag">album_list</property>
                                  <property name="child">
                                    <object class="GtkScrolledWindow">
                                      <child>
                                        <object class="GtkListView" id="artist_sidebar">
                                          <property name="single-click-activate">True</property>
                                        </object>
                                      </child>
                                    </object>
                                  </property>
                                </object>
                              </property>
                              <property name="content">
                                <object class="AdwNavigationPage" id="artist_nav_3">
                                  <property name="title" translatable="yes">Content</property>
                                  <property name="tag">album_details</property>
                                  <property name="child">
                                    <object class="GtkScrolledWindow">
                                      <child>
                                        <object class="GtkListView" id="album_sidebar">
                                          <property name="single-click-activate">True</property>
                                        </object>
                                      </child>
                                    </object>
                                  </property>
                                </object>
                              </property>
                            </object>
                        </property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="AdwNavigationPage">
                        <property name="title" translatable="yes">Content</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <child>
                              <object class="AlbumHeader" id="album_details_content">
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage" id="playlist_stack">
                <property name="name">playlists</property>
                <property name="title">Playlists</property>
                <property name="icon-name">view-list-ordered-symbolic</property>
                <property name="visible">False</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <child>
                      <object class="GtkListView" id="playlistview">
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage" id="queue_stack">
                <property name="name">queue</property>
                <property name="title">Queue</property>
                <property name="icon-name">view-list-ordered-symbolic</property>
                <property name="visible">False</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="_scrolled_window_queue">
                    <child>
                      <object class="GtkListView" id="queueview">
                        <!--property name="max-columns">10</property>
                        <property name="single-click-activate">True</property-->
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="AdwViewSwitcherBar" id="switcher_bar">
            <property name="stack">stack</property>
          </object>
        </child>
        <child type="bottom">
          <object class="Controls" id="controls">
            <!-- property name="text">test</property-->
          </object>
        </child>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About NextGroove</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <menu id="album_click_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Play</attribute>
        <attribute name="action">app.album_play_clicked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Add to queue</attribute>
        <attribute name="action">app.album_queue_add_end_clicked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Add to queue (play next)</attribute>
        <attribute name="action">app.album_queue_add_next_clicked</attribute>
      </item>
    </section>
  </menu>
</interface>
