<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NextcloudmusicWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">ActionGrooveNC</property>
    <property name="default-width">1000</property>
    <property name="default-height">600</property>
    <property name="adaptive-preview">false</property>
    <child>
      <object class="AdwBreakpoint" id="breaker">
         <condition>max-width: 600sp</condition>
        <setter object="switcher_bar" property="reveal">True</setter>
        <setter object="split_view" property="collapsed">True</setter>
          <setter object="header_bar" property="title-widget"/>
        </object>
    </child>
    <child>
      <object class="AdwBreakpoint" id="breaker2">
         <condition>min-width: 599sp</condition>
        </object>
    </child>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="title-widget">
              <object class="GtkBox" id="tab_header">
                <property name="spacing">4</property>
                <style>
                  <class name="linked"/>
                </style>
                <child>
                  <object class="GtkToggleButton" id="album_tab_button">
                    <property name="label" translatable="yes">Albums</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="artist_tab_button">
                    <property name="label" translatable="yes">Artist</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="playlist_tab_button">
                    <property name="label" translatable="yes">Playlists</property>
                  </object>
                </child>
              </object>
            </property>
            <child type="start">
              <object class="GtkButton" id="header_back_button">
                <property name="icon-name">go-previous-symbolic</property>
                <property name="sensitive">false</property>
                <property name="tooltip-text" translatable="yes">Back</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkSearchEntry" id="main_search">
                <property name="visible">false</property>
                <property name="placeholder-text" translatable="yes">Search</property>
                <property name="width-chars">24</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="queue_toggle">
                <property name="active">True</property>
                <property name="icon-name">sidebar-show-symbolic</property>
                <property name="tooltip-text" translatable="yes">Queue</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="Controls" id="controls">
            <!-- property name="text">test</property-->
          </object>
        </child>
        <child type="top">
          <object class="AdwViewSwitcherBar" id="switcher_bar">
            <property name="stack">stack</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwOverlaySplitView" id="split_view">
            <property name="sidebar-position">end</property>
            <property name="sidebar-width-fraction">0.33</property>
            <property name="min-sidebar-width">280</property>
            <property name="max-sidebar-width">450</property>
            <property name="show-sidebar">True</property>
            <property name="content">
          <object class="AdwViewStack" id="stack">
            <child>
              <object class="AdwViewStackPage" id="welcomepage">
                <property name="name">welcome</property>
                <property name="title">Welcome</property>
                <property name="icon-name">user-home-symbolic</property>
                <property name="child">
                  <object class="AdwToastOverlay" id="status_toast">
                    <property name="child">
                      <object class="AdwStatusPage" id="welcome_status_page">
                        <style>
                          <class name="login-bg"/>
                        </style>
                        <property name="title">Welcome</property>
                        <property name="description">Retrieving collection...</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkButton" id="welcome_login_button">
                                <property name="halign">center</property>
                                <property name="visible">false</property>
                                <!-- Translators: Button -->
                                <property name="label" translatable="yes">Login</property>
                                <!-- Translators: Button tooltip -->
                                <property name="tooltip-text" translatable="yes">Continue to URL Entry</property>
                                <signal name="clicked" handler="_do_login"/>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <!-- Retry -->
                            <child>
                              <object class="GtkButton" id="welcome_retry_button">
                                <property name="visible">false</property>
                                <property name="halign">center</property>
                                <!-- Translators: Button -->
                                <property name="label" translatable="yes">Retry</property>
                                <!-- Translators: Button tooltip -->
                                <property name="tooltip-text" translatable="yes">Retry refreshing library</property>
                                <signal name="clicked" handler="_do_retry"/>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <!-- loading -->
                            <child>
                              <object class="AdwSpinner" id="welcome_spinner">
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                                <property name="width-request">48</property>
                                <property name="height-request">48</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage" id="fake_stack">
                <property name="name"></property>
                <property name="title"></property>
                <property name="icon-name">media-optical-cd-audio-symbolic</property>
                <property name="visible">True</property>
                <property name="child">
                  <object class="GtkBox"></object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage" id="album_stack">
                <property name="name">albums</property>
                <property name="title">Albums</property>
                <property name="icon-name">media-optical-cd-audio-symbolic</property>
                <property name="visible">False</property>
                <property name="child">
                  <object class="AdwNavigationView" id="album_navigation">
                    <child>
                      <object class="AdwNavigationPage" id="album_navigation_page">
                        <property name="title" translatable="yes">Albums</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkScrolledWindow" id="_scrolled_window">
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkGridView" id="albumview">
                                    <property name="max-columns">10</property>
                                    <property name="single-click-activate">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwNavigationPage" id="album_tab_details">
                        <property name="title" translatable="yes">Album Details</property>
                        <property name="tag">album_list</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <property name="content">
                              <object class="GtkScrolledWindow">
                                <style>
                                  <class name="album-details-bg"/>
                                </style>
                                <child>
                                  <object class="AlbumHeader" id="album_tab_details_content">
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>


                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage" id="artist_stack">
                <property name="name">artist</property>
                <property name="title">Artist</property>
                <property name="visible">False</property>
                <property name="icon-name">system-users</property>
                <property name="child">
                  <object class="AdwNavigationView" id="outer_artist_split">
                    <child>
                      <object class="AdwNavigationPage" id="artist_nav_1">
                        <property name="title" translatable="yes">Artists</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkListView" id="artist_sidebar">
                                    <property name="single-click-activate">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwNavigationPage" id="artist_nav_2">
                        <property name="title" translatable="yes">Albums</property>
                        <property name="tag">album_list</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <property name="content">
                              <object class="GtkScrolledWindow">
                                <child>
                                  <object class="GtkListView" id="album_sidebar">
                                    <property name="single-click-activate">True</property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwNavigationPage" id="artist_nav_3">
                        <property name="title" translatable="yes">Content</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <property name="content">
                              <object class="GtkScrolledWindow">
                                <style>
                                  <class name="album-details-bg"/>
                                </style>
                                <child>
                                  <object class="AlbumHeader" id="album_details_content">
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage" id="playlist_stack">
                <property name="name">playlists</property>
                <property name="title">Playlists</property>
                <property name="icon-name">view-list-ordered-symbolic</property>
                <property name="visible">False</property>
                <property name="child">
                  <object class="AdwNavigationView" id="playlist_nav_view">
                    <child>
                      <object class="AdwNavigationPage" id="playlist_list_page">
                        <property name="title" translatable="yes">Playlists</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <child>
                              <object class="GtkListView" id="playlistview">
                                <property name="single-click-activate">True</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwNavigationPage" id="playlist_details_page">
                        <property name="title" translatable="yes">Playlist Details</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <property name="content">
                              <object class="GtkScrolledWindow">
                                <style>
                                  <class name="album-details-bg"/>
                                </style>
                                <child>
                                  <object class="PlaylistHeader" id="playlistdetails">
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
            </property>
            <property name="sidebar">
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <child>
                  <object class="GtkBox">
                    <property name="width-request">1</property>
                    <property name="margin-top">24</property>
                    <property name="margin-bottom">24</property>
                    <style>
                      <class name="queue-separator"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="QueuePage" id="queuepage">
                    <property name="hexpand">True</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <!-- DE (2026-11-14): Put library refresh first in the main menu. -->
      <item>
        <attribute name="label" translatable="yes">Refresh</attribute>
        <attribute name="action">win.refresh</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About ActionGrooveNC</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_ActionGrooveNC Wrapped</attribute>
        <attribute name="action">app.wrapped</attribute>
      </item>
    </section>
  </menu>
  <menu id="album_click_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Play</attribute>
        <attribute name="action">app.album_play_clicked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_View details</attribute>
        <attribute name="action">app.album_view_details_clicked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Add to queue</attribute>
        <attribute name="action">app.album_queue_add_end_clicked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Add to queue (play next)</attribute>
        <attribute name="action">app.album_queue_add_next_clicked</attribute>
      </item>
    </section>
  </menu>
</interface>
