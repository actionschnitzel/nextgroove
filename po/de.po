#. Translators: Title
#: src/gtk/nextcloud_login_dialog.ui:16
msgid "ActionGrooveNC Login"
msgstr "ActionGrooveNC-Anmeldung"

#. Translators: Description
#: src/gtk/nextcloud_login_dialog.ui:31
msgid ""
"Press Continue to provide your Nextcloud server address and login via a web "
"browser"
msgstr ""
"Klicke auf „Weiter“, um deine Nextcloud-Serveradresse anzugeben und dich "
"über den Webbrowser anzumelden"

#. Translators: Button
#: src/gtk/nextcloud_login_dialog.ui:36 src/gtk/nextcloud_login_dialog.ui:93
#: src/gtk/play_stats_dialog.ui:39
msgid "Continue"
msgstr "Weiter"

#. Translators: Button tooltip
#: src/gtk/nextcloud_login_dialog.ui:38 src/gtk/window.ui:121
msgid "Continue to URL Entry"
msgstr "Weiter zur URL-Eingabe"

#. Translators: Title
#: src/gtk/nextcloud_login_dialog.ui:56
msgid "Secret Service Inaccessible"
msgstr "Secret Service nicht erreichbar"

#. Translators: Description
#: src/gtk/nextcloud_login_dialog.ui:58
msgid ""
"The Secret Service could not be accessed for storing authentication details. "
"Ensure you have a provider such as gnome-keyring. A default keyring needs to "
"be setup, and that keyring unlocked. Most desktop environments will provide "
"this for you. Restart the app to try again."
msgstr ""
"Auf den Secret Service zum Speichern der Anmeldedaten konnte nicht "
"zugegriffen werden. Stelle sicher, dass ein Anbieter wie gnome-keyring "
"vorhanden ist. Ein Standard-Schlüsselbund muss eingerichtet und entsperrt "
"sein. Die meisten Desktop-Umgebungen stellen dies bereit. Starte die App "
"neu, um es erneut zu versuchen."

#. Translators: Description
#: src/gtk/nextcloud_login_dialog.ui:80
msgid "Server URL"
msgstr "Server-URL"

#. Translators: Button tooltip
#: src/gtk/nextcloud_login_dialog.ui:95
msgid "Start Login"
msgstr "Anmeldung starten"

#. Translators: Title
#: src/gtk/nextcloud_login_dialog.ui:130
msgid "Connection Established"
msgstr "Verbindung hergestellt"

#. Translators: Button
#: src/gtk/nextcloud_login_dialog.ui:145 src/gtk/play_stats_dialog.ui:88
msgid "Done"
msgstr "Fertig"

#. Translators: Button tooltip
#: src/gtk/nextcloud_login_dialog.ui:147
msgid "Complete Sync Setup"
msgstr "Synchronisierung abschließen"

