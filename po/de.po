#: data/net.rosebirch.nextgroove.desktop.in:2
#: data/net.rosebirch.nextgroove.metainfo.xml.in:8 src/gtk/window.ui:6
msgid "NextGroove"
msgstr "NextGroove"

#: data/net.rosebirch.nextgroove.desktop.in:8
msgid "GTK;"
msgstr "GTK;"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:9
msgid "Play music from Nextcloud"
msgstr "Musik aus Nextcloud abspielen"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:11
msgid ""
"Nextgroove lets you browse and play songs from your Nextcloud instance (with "
"Nextcloud Music installed)."
msgstr ""
"Mit Nextgroove kannst du Songs aus deiner Nextcloud-Instanz durchsuchen und "
"abspielen (mit installierter Nextcloud Music)."

#: data/net.rosebirch.nextgroove.metainfo.xml.in:12
msgid "Features:"
msgstr "Funktionen:"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:14
msgid "Connects to a Nextcloud instance of your choice."
msgstr "Verbindet sich mit einer Nextcloud-Instanz deiner Wahl."

#: data/net.rosebirch.nextgroove.metainfo.xml.in:15
msgid ""
"Does download album art, images in screenshots are modified for copyright "
"reasons."
msgstr ""
"Lädt Albumcover herunter. Die Bilder in den Screenshots wurden aus "
"urheberrechtlichen Gründen verändert."

#: data/net.rosebirch.nextgroove.metainfo.xml.in:16
msgid ""
"Can select albums, playlists or individual songs from either to the queue."
msgstr ""
"Alben, Playlists oder einzelne Songs können zur Warteschlange hinzugefügt "
"werden."

#: data/net.rosebirch.nextgroove.metainfo.xml.in:17
msgid ""
"Basic MPRIS support allowing to be controlled via common controls and "
"shortcuts."
msgstr ""
"Grundlegende MPRIS-Unterstützung, sodass die Wiedergabe über gängige "
"Steuerelemente und Tastenkürzel gesteuert werden kann."

#: data/net.rosebirch.nextgroove.metainfo.xml.in:18
msgid "Can create playlists from the current play queue."
msgstr "Aus der aktuellen Warteschlange können Playlists erstellt werden."

#: data/net.rosebirch.nextgroove.metainfo.xml.in:19
msgid "Able to optionally cache songs"
msgstr "Songs können optional zwischengespeichert werden"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:24
msgid "Dean Birch"
msgstr "Dean Birch"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:48
msgid "Nextcloud"
msgstr "Nextcloud"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:49
msgid "Music"
msgstr "Musik"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:61
msgid "Screenshot of the album view of NextGroove"
msgstr "Screenshot der Albumansicht von NextGroove"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:65
msgid "Album details view of NextGroove"
msgstr "Albumdetails in NextGroove"

#: data/net.rosebirch.nextgroove.metainfo.xml.in:69
msgid "Viewing a playlist in NextGroove"
msgstr "Anzeige einer Playlist in NextGroove"

#: src/gtk/albumheader.ui:111 src/gtk/playlistheader.ui:90
msgid "Play in order"
msgstr "In Reihenfolge abspielen"

#: src/gtk/albumheader.ui:118 src/gtk/playlistheader.ui:97
msgid "Play shuffled"
msgstr "Zufällig abspielen"

#: src/gtk/albumheader.ui:134 src/gtk/albumheader.ui:150
#: src/gtk/playlistheader.ui:128 src/gtk/window.ui:395
msgid "_Play"
msgstr "_Abspielen"

#: src/gtk/albumheader.ui:138 src/gtk/albumheader.ui:154
#: src/gtk/playlistheader.ui:132 src/gtk/window.ui:403
msgid "_Add to queue"
msgstr "Zur _Warteschlange hinzufügen"

#: src/gtk/albumheader.ui:142 src/gtk/albumheader.ui:158
#: src/gtk/playlistheader.ui:136 src/gtk/window.ui:407
msgid "_Add to queue (play next)"
msgstr "Zur _Warteschlange hinzufügen (als Nächstes)"

