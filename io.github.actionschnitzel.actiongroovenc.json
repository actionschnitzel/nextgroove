{
    "id" : "io.github.actionschnitzel.actiongroovenc",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "command" : "actiongroovenc",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio"
    ],
    "modules" : [
        "python3-requests.json",
        {
            "name" : "actiongroovenc",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/dean36963/nextgroove",
                    "tag" : "0.5.1-rc1"
                }
            ],
            "config-opts" : [
                "--libdir=lib"
            ]
        }
    ]
}
